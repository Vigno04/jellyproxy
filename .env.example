# Copy to .env and fill in your deployment values. .env is git-ignored.
#
# URL of the upstream Jellyfin server as reachable from the proxy container
# (e.g. a mesh/reverse-proxy internal origin route).
UPSTREAM_URL=https://example.internal:10000
# Host header sent upstream (must match the upstream server's configured hostname).
UPSTREAM_HOST=jellyfin.example.com
# Pre-shared secret used for plugin<->proxy request authentication. Generate with:
#   openssl rand -hex 24
SHARED_SECRET=replace-with-generated-secret
# Optional overrides (defaults shown):
#PORT=8096
#CACHE_DIR=/var/cache/jellyproxy
#LOG_LEVEL=info
#CONTAINER_NAME=jellyproxy
#RESTART_POLICY=unless-stopped
#NETWORK_MODE=bridge
